# Normalización de finales de línea entre Windows, macOS y Linux
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
