# Copia este archivo a .env y reemplaza SECRET_KEY antes de iniciar la app.
# Nunca subas .env al repositorio.

APP_NAME="Eventos y Actividades Académicas"
APP_ENV=development
DATABASE_URL=sqlite:///./eventos.db

# Genera una clave aleatoria con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIA-ESTA-CLAVE-POR-UNA-SECRETA-DE-AL-MENOS-32-CARACTERES

# Obligatorio en true (HTTPS en todos los entornos; mkcert en local)
COOKIE_SECURE=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
ALLOWED_ORIGINS=["https://localhost:8000","https://127.0.0.1:8000"]
LOG_LEVEL=INFO
