    "/api/v1/catalogo/eventos": {
      "get": {
        "description": "Devuelve eventos publicados paginados con filtros y disponibilidad real.",
        "operationId": "listar_catalogo_api_v1_catalogo_eventos_get",
        "parameters": [
          {
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TipoEvento"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tipo"
            }
          },
          {
            "in": "query",
            "name": "modalidad",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Modalidad"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Modalidad"
            }
          },
          {
            "in": "query",
            "name": "fecha_desde",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fecha Desde"
            }
          },
          {
            "in": "query",
            "name": "fecha_hasta",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Fecha Hasta"
            }
          },
          {
            "in": "query",
            "name": "texto",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Texto"
            }
          },
          {
            "in": "query",
            "name": "incluir_finalizados",
            "required": false,
            "schema": {
              "default": false,
              "title": "Incluir Finalizados",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "pagina",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Pagina",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "tamano",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Tamano",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogoPaginadoSalida"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar catálogo público de eventos publicados",
        "tags": [
          "Catálogo"
        ]
      }
    },
